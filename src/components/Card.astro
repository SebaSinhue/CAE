---
interface Props {
  titulo: string;
}

const { titulo } = Astro.props;
---

<div class="bg-white p-8 rounded-2xl border border-gray-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group cursor-pointer relative overflow-hidden flex flex-col h-full" data-aos="fade-up">
  <div class="absolute top-0 left-0 w-full h-1.5 bg-[#FFF7E6] group-hover:bg-[#F2A900] transition-colors duration-300"></div>

  <h2 class="font-sans-flex text-2xl font-bold mb-4 text-[#111827] group-hover:text-[#F2A900] transition-colors duration-300">
    {titulo}
  </h2>

  <div class="text-[#4B5563] text-base leading-relaxed font-normal grow">
    <slot />
  </div>

  <div class="mt-8 flex items-center justify-center gap-6 md:gap-8 px-6 py-4 rounded-2xl">
    <img src="/CAE/Divisiones_Negro-07.png" alt="Logo Inferior 1" class="h-12 md:h-14 w-auto object-contain transition-transform hover:scale-105 duration-300" />
    <span class="h-8 w-[1px] bg-gray-200"></span>
    <img src="/CAE/ICO-08.png" alt="Logo Inferior 2" class="h-12 md:h-14 w-auto object-contain transition-transform hover:scale-105 duration-300" />
  </div>
</div>