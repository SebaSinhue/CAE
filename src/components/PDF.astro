---
interface Props {
  id: string;
  title: string;
  pdfUrl: string;
}

const { id, title, pdfUrl } = Astro.props;
---

<main id={id} class="scroll-mt-24 px-6 py-4">
    <div class="mx-auto max-w-4xl">
        <div class="mb-4 text-center">
            <span class="mx-auto block h-1 w-16 rounded-full bg-[#F2A900]"></span>

            <h2 class="mx-auto mt-4 max-w-2xl text-xl font-bold tracking-tight text-[#111827] md:text-2xl uppercase leading-tight">
                {title}
            </h2>
        </div>

        <div class="rounded-xl border border-gray-200 bg-white p-3 shadow-sm md:p-4">
            <div class="w-full aspect-[1.414/1] overflow-hidden rounded-lg border border-gray-300 bg-[#1F2937]">
                <iframe
                    src={`${pdfUrl}#toolbar=1&navpanes=0&view=FitH`}
                    title={title}
                    class="w-full h-full border-0 bg-transparent"
                >
                </iframe>
            </div>
        </div>

        <div class="mt-4 flex flex-col items-center justify-between gap-4 md:flex-row border-t border-gray-100 pt-4">
            <p class="text-xs text-[#4B5563]">
                Si el visor no carga correctamente, abre el archivo en una nueva pestaña.
            </p>

            <a
                href={pdfUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-lg bg-[#F2A900] px-5 py-2.5 text-xs font-semibold text-[#111827] shadow-sm transition hover:bg-[#D49400] whitespace-nowrap"
            >
                Abrir PDF
            </a>
        </div>
    </div>
</main>