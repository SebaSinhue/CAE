---
import { Icon } from "astro-icon/components";
---

<footer id="contacto" class="bg-gray-600 border-t border-white/10 text-white font-sans">
    <div class="mx-auto max-w-7xl px-6 py-10 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-start">
        
        <div class="lg:col-span-5 flex flex-col space-y-4 items-center justify-center text-center border-b lg:border-b-0 lg:border-r border-white/10 pb-6 lg:pb-0 lg:pr-8 w-full">
            
            <div class="flex items-center space-x-4 transition-transform duration-300 hover:scale-105">
                <img src="/CAE/Divisiones_Blanco-07.png" class="h-14 w-auto object-contain" alt="Divisiones FES Aragón" />
                <span class="h-8 w-[1px] bg-white/20"></span>
                <img src="/CAE/ICO-09.png" class="h-14 w-auto object-contain" alt="Ingeniería en Computación" />
            </div>
            
            <div class="space-y-0.5">
                <h3 class="text-3xl font-black tracking-tighter text-white font-sans-flex leading-none drop-shadow-sm">
                    CAE
                </h3>
                <p class="text-[11px] text-[#F2A900] uppercase tracking-[0.25em] font-bold">
                    Centro de Apoyo Extracurricular
                </p>
            </div>
            
            <p class="text-xs text-[#9CA3AF] max-w-sm leading-relaxed font-medium">
                Espacio de la Carrera de Ingeniería en Computación creado para respaldar tu aprendizaje y práctica profesional.
            </p>
        </div>

        <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-8 w-full lg:pt-2">
            
            <div class="flex flex-col space-y-3 items-center sm:items-start text-center sm:text-left">
                <h3 class="text-xs font-bold uppercase tracking-[0.2em] text-[#F2A900] border-b border-[#F2A900]/20 pb-1 w-full sm:w-auto">
                    Personal Responsable
                </h3>
                <ul class="space-y-3 text-sm text-white/90 w-full">
                    <li class="flex flex-col gap-0.5">
                        <p class="font-bold text-gray-100 flex items-center justify-center sm:justify-start gap-2">
                            <Icon name="lucide:user" class="w-3.5 h-3.5 text-[#F2A900] shrink-0" />
                            Ing. Ana Claudia Reyes Cruz
                        </p>
                        <p class="text-xs text-[#9CA3AF] pl-0 sm:pl-5">Jefa de Carrera ICO</p>
                    </li>
                    <li class="flex flex-col gap-0.5">
                        <p class="font-bold text-gray-100 flex items-center justify-center sm:justify-start gap-2">
                            <Icon name="lucide:user" class="w-3.5 h-3.5 text-[#F2A900] shrink-0" />
                            Ing. Roberto Agustín García Castrejón
                        </p>
                        <p class="text-xs text-[#9CA3AF] pl-0 sm:pl-5">Secretario Técnico ICO</p>
                    </li>
                    <li class="flex flex-col gap-0.5">
                        <p class="font-bold text-gray-100 flex items-center justify-center sm:justify-start gap-2">
                            <Icon name="lucide:user" class="w-3.5 h-3.5 text-[#F2A900] shrink-0" />
                            Ing. Alberto González Ledesma
                        </p>
                        <p class="text-xs text-[#9CA3AF] pl-0 sm:pl-5">Encargado de Área CAE</p>
                    </li>
                </ul>
            </div>

            <div class="flex flex-col space-y-5 items-center sm:items-start text-center sm:text-left">
                <div class="space-y-3 w-full">
                    <h3 class="text-xs font-bold uppercase tracking-[0.2em] text-[#F2A900] border-b border-[#F2A900]/20 pb-1 w-full sm:w-auto">
                        Ubicación y Contacto
                    </h3>
                    <div class="space-y-2.5 text-sm text-white/90">
                        <p class="flex items-center justify-center sm:justify-start gap-2">
                            <Icon name="lucide:map-pin" class="w-3.5 h-3.5 text-[#F2A900] shrink-0" />
                            <span>Sala 205, Edificio A2</span>
                        </p>
                        <p class="flex items-center justify-center sm:justify-start gap-2">
                            <Icon name="lucide:mail" class="w-3.5 h-3.5 text-[#F2A900] shrink-0" />
                            <a href="mailto:cae@aragon.unam.mx" class="hover:text-[#F2A900] transition-colors break-all underline decoration-white/10 hover:decoration-[#F2A900]">cae@aragon.unam.mx</a>
                        </p>
                    </div>
                </div>

                <div class="w-full pt-1">
                    <p class="text-xs font-semibold text-[#9CA3AF] uppercase tracking-wider mb-2.5">Comunidad ICO</p>
                    <div class="flex justify-center sm:justify-start gap-3">
                        <a
                            href="https://www.facebook.com/FESAragon.computacion"
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="Facebook Oficial de Computación FES Aragón"
                            class="p-2 bg-white/5 rounded-xl border border-white/10 text-white transition-all hover:scale-110 hover:bg-[#F2A900] hover:text-[#111827] hover:border-[#F2A900]/30 shadow-sm"
                        >
                            <Icon name="simple-icons:facebook" class="w-4 h-4" />
                        </a>

                        <a
                            href="https://www.instagram.com/icofesaragon/"
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="Instagram Oficial de ICO FES Aragón"
                            class="p-2 bg-white/5 rounded-xl border border-white/10 text-white transition-all hover:scale-110 hover:bg-[#F2A900] hover:text-[#111827] hover:border-[#F2A900]/30 shadow-sm"
                        >
                            <Icon name="simple-icons:instagram" class="w-4 h-4" />
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <div class="bg-[#1F2937] px-6 py-4 border-t border-white/5 text-center text-xs text-[#9CA3AF]">
        <div class="mx-auto max-w-7xl flex flex-col sm:flex-row items-center justify-between gap-4">
            <p>&copy; {new Date().getFullYear()} Centro de Apoyo Extracurricular — FES Aragón UNAM.</p>
        </div>
    </div>
</footer>