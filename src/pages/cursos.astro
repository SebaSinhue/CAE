---

<Layout title="Cursos Intersemestrales - CAE FES Aragón">
    <Navbar />
    
    <div class="max-w-7xl mx-auto px-6 mt-32 mb-20">
        
        <div class="mb-12 border-b border-[#9CA3AF]/30 pb-8 text-center md:text-left">
            <h1 class="text-4xl font-extrabold text-[#111827] tracking-tight sm:text-5xl">
                Cursos <span class="text-[#F2A900]">Intersemestrales</span>
            </h1>
            <p class="text-[#4B5563] mt-3 text-lg max-w-3xl">
                ¡Fortalece tus habilidades con nuestra oferta de cursos de junio! Contamos con modalidades presenciales y en línea para potenciar tu perfil profesional.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {cursos.map((curso) => (
                <Card titulo={curso.titulo}>
                    <div class="flex flex-col h-full justify-between mt-3">
                        <div>
                            <div class="flex gap-2 mb-4 flex-wrap">
                                <span class="bg-[#FFF7E6] text-[#D49400] text-xs font-bold px-3 py-1 rounded-full border border-[#F2A900]/30">
                                    {curso.categoria}
                                </span>
                                <span class={`text-xs font-bold px-3 py-1 rounded-full border ${
                                    curso.modalidad === 'Línea' 
                                    ? 'bg-blue-50 text-blue-600 border-blue-200' 
                                    : 'bg-green-50 text-green-600 border-green-200'
                                }`}>
                                    💻 {curso.modalidad}
                                </span>
                            </div>

                            <div class="space-y-2 text-sm text-[#4B5563] mb-6">
                                <p><strong class="text-[#111827]">Impartido por:</strong> {curso.instructor}</p>
                                <p><strong class="text-[#111827]">Calendario:</strong> {curso.fecha}</p>
                                <div class="flex justify-between text-xs text-[#9CA3AF] pt-2 border-t border-gray-100">
                                    <span>⏱️ {curso.horas}</span>
                                    <span>👥 Cupo: {curso.cupo}</span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="flex flex-col gap-2">
                            <a href={curso.link} target="_blank" rel="noopener noreferrer" class="w-full text-center inline-block px-4 py-2 text-xs font-bold text-[#374151] bg-[#FFF7E6] border border-[#F2A900]/40 rounded-lg hover:bg-[#F2A900] hover:text-white transition-all">
                                 Ver Folleto Informativo
                            </a>

                            <a href={curso.registro} target="_blank" rel="noopener noreferrer" class={`w-full text-center inline-block px-4 py-2.5 text-sm font-bold text-white rounded-lg transition-all ${
                                curso.registro === '#' 
                                ? 'bg-gray-300 cursor-not-allowed pointer-events-none' 
                                : 'bg-[#111827] hover:bg-[#374151] hover:shadow-md'
                            }`}>
                                {curso.registro === '#' ? 'Registro No Disponible' : ' Inscribirse Directo'}
                            </a>
                        </div>
                    </div>
                </Card>
            ))}
        </div>
    </div>

    <Footer />
</Layout>