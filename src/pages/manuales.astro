---
import "../styles/global.css";
//Datos del Manual
const Manual = {
    manComp: "MANUAL DE USO PARA UNA COMPUTADORA DE ESCRITORIO",
    manExt: "MANUAL DE USO PARA UN EXTINTOR",
    descripcion:
        "Consulta el documento oficial con instrucciones y recomendaciones para el uso correcto del equipo.",
    pdfCompu: "/Manuales/manual-uso-computadora.pdf",
    pdfExt: "/Manuales/manual-extintor.pdf"
};
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/jpg" href="/cae-logo.jpg">
        <title>Manuales de Uso | CAE FES Aragon</title>
        <meta
            name="description"
            content="Consulta los manuales de uso del CAE FES Aragon"
        />
    </head>
    <header class="fixed left-0 top-0 z-50 w-full bg-black shadow-md">
        <div class="flex h-14 items-center px-5">
            <img src="../../public/cae-logo.jpg" alt="Logo CAE" class="h-9 w-9 bg-white p-1"/>
            <span class="ml-4 font-serif text-lg font-bold text-white">
                CAE FES Aragon
            </span>
        </div> 
    </header>

    <body class="bg-slate-100 text-slate-900">
        <section class="relative overflow-hidden bg-slate-950">
            <div class="absolute insert-0 bg-[url('')] bg-cover bg-center opacity-30">
                <div class="relative z-10 mx-auto flex min-h-[320px] max-w-7x1 flex-col items-center justify-center px-6 text-center">
                </div>
                <p class="mb-4 text-sm font-semibold uppercase tracking-[0.35cm] text-blue-300">
                    CAE FES Aragon
                </p>
                <h1 class="text-5x1 font-bold text-white md:text-7x1">
                    Manuales de uso
                </h1>
                <p class="mt-6 max-w-3x1 text-lg text-slate-200 md:text-x1">
                    Documentación oficial para el uso correcto de equipos y
                    recursos del Centro de Apoyo Educativo.
                </p>
            </div>
        </section>


        <main class="px-4 py-16">
            <div class="mx-auto max-w-6x1">
                <div class="mb-10 text-center">
                    <span class="inline-block rounded-full bg-blue-100 px-4 py-1 text-sm font-semibold text-blue-700">
                        Documento PDF
                    </span>

                    <h2 class="mt-4 text-3x1 font-bold tracking-tight text-slate-900 md:text-4x1">
                        {Manual.manComp}
                    </h2>
                    <p class="mx-auto mt-4 max-w-2x1 text-base text-slate-600">
                        {Manual.descripcion}
                    </p>
                </div>

                <div class="rounded-3xl bg-white p-4 shadow-2xl ring-1 ring-slate-200 md:p-6">
                <div class="overflow-hidden rounded-2xl border border-slate-300 bg-slate-900">
                    <iframe src={`${Manual.pdfCompu}#toolbar=1&zoom=page-width`} title={Manual.manComp} class="w-full h-[70vh]"></iframe>
                </div>
                </div>

                <div class="mt-6 flex flex-col items-center justify-between gap-4 md:flex-row">
                    <p class="text-sm text-slate-500">
                        Si el visor no carga correctamente, abre el archivo en una nueva pestaña
                    </p>

                    <a href={Manual.pdfCompu} target="_blank" rel="noopener noreferrer" class="rounded-xl bg-blue-700 px-6 py-3 text-sm font-semibold text-white shadow-lg transition hover:bg-blue-800">
                        Abrir PDF
                    </a>
                </div>
            </div>
        </main>

               <main class="px-4 py-16">
            <div class="mx-auto max-w-6x1">
                <div class="mb-10 text-center">
                    <span class="inline-block rounded-full bg-blue-100 px-4 py-1 text-sm font-semibold text-blue-700">
                        Documento PDF
                    </span>

                    <h2 class="mt-4 text-3x1 font-bold tracking-tight text-slate-900 md:text-4x1">
                        {Manual.manExt}
                    </h2>
                    <p class="mx-auto mt-4 max-w-2x1 text-base text-slate-600">
                        {Manual.descripcion}
                    </p>
                </div>

                <div class="rounded-3xl bg-white p-4 shadow-2xl ring-1 ring-slate-200 md:p-6">
                <div class="overflow-hidden rounded-2xl border border-slate-300 bg-slate-900">
                    <iframe src={`${Manual.pdfExt}#toolbar=1&zoom=page-width`} title={Manual.manExt} class="w-full h-[70vh]"></iframe>
                </div>
                </div>

                <div class="mt-6 flex flex-col items-center justify-between gap-4 md:flex-row">
                    <p class="text-sm text-slate-500">
                        Si el visor no carga correctamente, abre el archivo en una nueva pestaña
                    </p>

                    <a href={Manual.pdfExt} target="_blank" rel="noopener noreferrer" class="rounded-xl bg-blue-700 px-6 py-3 text-sm font-semibold text-white shadow-lg transition hover:bg-blue-800">
                        Abrir PDF
                    </a>
                </div>
            </div>
        </main>

        <footer class="bg-slate-950 px-6 py-10 text-white">
            <div class="mx-auto grid max-w-6xl gap-8 md:grid-cols-2 md:items-center">
                <div class="space-y-2">
                    <h3 class="text-xl font-bold">Contacto</h3>
                    <p class="text-slate-300">Ing. Ana Claudia Reyes Cruz</p>
                    <p class="text-slate-300">Ing. Roberto Agustin Garcia Castrejon</p>
                    <p class="text-slate-300">cae@aragon.unam.mx</p>
                </div>

                <div class="flex justify-start md:justify-end">
                    <img src="../../public/cae-logo.jpg" alt="Logo CAE FES Aragon" class="h-24 w-24 rounded-xl bg-white p-2 shadow-lg">
                </div>
            </div>
        </footer>
    </body>
</html>
