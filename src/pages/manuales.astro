---
import "../styles/global.css";

// Datos del Manual
const Manual = {
    manComp: "MANUAL DE USO PARA UNA COMPUTADORA DE ESCRITORIO",
    manExt: "MANUAL DE USO PARA UN EXTINTOR",
    pdfCompu: "/Manuales/manual-uso-computadora.pdf",
    pdfExt: "/Manuales/manual-extintor.pdf"
};
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/jpg" href="/cae-logo.jpg" />
        <title>Manuales de Uso | CAE FES Aragón</title>
        <meta
            name="description"
            content="Consulta los manuales de uso del CAE FES Aragón"
        />
    </head>

    <body class="bg-[#F9FAFB] text-[#111827]">

<!-- NAVBAR -->
<header class="fixed left-0 top-0 z-50 w-full bg-[#4B5563] shadow-md">
    <nav class="mx-auto flex h-24 max-w-7xl items-center justify-between px-6">
        <a href="/" class="flex items-center gap-4">
            <img
                src="/divIngWhite.png"
                alt="Logo Ingeniería"
                class="h-14 w-14 object-contain"
            />

            <img
                src="/logoIcoWhite.png"
                alt="Logo CAE"
                class="h-14 w-14 object-contain"
            />

            <span class="text-3xl font-bold text-white">
                CAE
            </span>
        </a>

        <!-- MENÚ DESKTOP -->
        <div class="hidden items-center gap-8 md:flex">
            <a href="/" class="text-base font-medium text-white transition hover:text-[#F2A900]">
                Inicio
            </a>

            <a href="/#nosotros" class="text-base font-medium text-white transition hover:text-[#F2A900]">
                Nosotros
            </a>

            <a href="/#informacion" class="text-base font-medium text-white transition hover:text-[#F2A900]">
                Información importante
            </a>

            <!-- DROPDOWN -->
            <div class="group relative">
                <button class="flex items-center gap-2 text-base font-medium text-white transition hover:text-[#F2A900]">
                    Recursos y Servicios
                    <span class="text-[#F2A900]">⌄</span>
                </button>

                <div class="invisible absolute right-0 top-full z-50 mt-4 w-64 rounded-xl bg-white py-4 text-[#111827] opacity-0 shadow-xl transition-all duration-200 group-hover:visible group-hover:opacity-100">
                    <a href="/manuales" class="block px-6 py-2 text-sm hover:bg-[#FFF7E6] hover:text-[#D49400]">
                        Manuales de Uso
                    </a>

                    <a href="#" class="block px-6 py-2 text-sm hover:bg-[#FFF7E6] hover:text-[#D49400]">
                        Sistema de Gestión de Calidad
                    </a>

                    <a href="#" class="block px-6 py-2 text-sm hover:bg-[#FFF7E6] hover:text-[#D49400]">
                        Laboratorios
                    </a>

                    <a href="#" class="block px-6 py-2 text-sm hover:bg-[#FFF7E6] hover:text-[#D49400]">
                        Cursos Intersemestrales
                    </a>

                    <a href="#" class="block px-6 py-2 text-sm hover:bg-[#FFF7E6] hover:text-[#D49400]">
                        ICO
                    </a>

                    <a href="#" class="block px-6 py-2 text-sm hover:bg-[#FFF7E6] hover:text-[#D49400]">
                        Buzón
                    </a>

                    <a href="#" class="block px-6 py-2 text-sm hover:bg-[#FFF7E6] hover:text-[#D49400]">
                        Servicio Social
                    </a>
                </div>
            </div>
        </div>
    </nav>
</header>

        <!-- HERO -->
        <section class="relative overflow-hidden bg-[#111827] pt-16">
            <div class="absolute inset-0 bg-gradient-to-br from-[#111827] via-[#1F2937] to-black"></div>

            <div class="absolute inset-0 opacity-20">
                <div class="h-full w-full bg-[radial-gradient(circle_at_top_right,_#F2A900,_transparent_35%)]"></div>
            </div>

            <div class="relative z-10 mx-auto flex min-h-[330px] max-w-7xl flex-col items-center justify-center px-6 text-center">
                <p class="mb-4 text-sm font-semibold uppercase tracking-[0.35em] text-[#F2A900]">
                    CAE FES Aragón
                </p>

                <h1 class="font-sans-flex font-bold text-4xl md:text-5xl text-[#D49400] drop-shadow-lg">
                    Manuales de uso
                </h1>

                <p class="mt-6 max-w-4xl mx-auto text-xl md:text-2xl text-white font-normal drop-shadow-md leading-relaxed">
                    Documentación oficial para el uso correcto de equipos y recursos del Centro de Apoyo Extracurricular.
                </p>
            </div>
        </section>

        <!-- ACCESOS RÁPIDOS -->
        <section id="manuales" class="px-6 py-16">
            <div class="mx-auto grid max-w-5xl gap-8 md:grid-cols-2">
                <a
                    href="#manual-computadora"
                    class="group rounded-xl border border-gray-200 bg-white p-8 shadow-sm transition hover:shadow-md"
                >
                    <span class="block h-1 w-16 rounded-full bg-[#F2A900]"></span>

                    <h2 class="mt-6 text-2xl font-bold text-[#111827]">
                        Computadora de escritorio
                    </h2>

                    <p class="mt-4 text-base leading-relaxed text-[#4B5563]">
                        Consulta instrucciones básicas para el uso correcto del equipo de cómputo.
                    </p>

                    <p class="mt-6 text-sm font-semibold text-[#D49400] transition group-hover:text-[#F2A900]">
                        Ver manual →
                    </p>
                </a>

                <a
                    href="#manual-extintor"
                    class="group rounded-xl border border-gray-200 bg-white p-8 shadow-sm transition hover:shadow-md"
                >
                    <span class="block h-1 w-16 rounded-full bg-[#F2A900]"></span>

                    <h2 class="mt-6 text-2xl font-bold text-[#111827]">
                        Uso de extintor
                    </h2>

                    <p class="mt-4 text-base leading-relaxed text-[#4B5563]">
                        Consulta recomendaciones de seguridad para el uso adecuado del extintor.
                    </p>

                    <p class="mt-6 text-sm font-semibold text-[#D49400] transition group-hover:text-[#F2A900]">
                        Ver manual →
                    </p>
                </a>
            </div>
        </section>

        <!-- MANUAL COMPUTADORA -->
        <main id="manual-computadora" class="scroll-mt-24 px-6 py-16">
            <div class="mx-auto max-w-6xl">
                <div class="mb-10 text-center">
                    <span class="mx-auto block h-1 w-20 rounded-full bg-[#F2A900]"></span>

                    <h2 class="mx-auto mt-6 max-w-5xl text-3xl font-bold tracking-tight text-[#111827] md:text-4xl">
                        {Manual.manComp}
                    </h2>
                </div>

                <div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm md:p-6">
                    <div class="overflow-hidden rounded-lg border border-gray-300 bg-[#1F2937]">
                        <iframe
                            src={`${Manual.pdfCompu}#toolbar=1&zoom=page-width`}
                            title={Manual.manComp}
                            class="h-[70vh] w-full"
                        >
                        </iframe>
                    </div>
                </div>

                <div class="mt-6 flex flex-col items-center justify-between gap-4 md:flex-row">
                    <p class="text-sm text-[#4B5563]">
                        Si el visor no carga correctamente, abre el archivo en una nueva pestaña.
                    </p>

                    <a
                        href={Manual.pdfCompu}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="rounded-lg bg-[#F2A900] px-6 py-3 text-sm font-semibold text-[#111827] shadow-sm transition hover:bg-[#D49400]"
                    >
                        Abrir PDF
                    </a>
                </div>
            </div>
        </main>

        <!-- MANUAL EXTINTOR -->
        <main id="manual-extintor" class="scroll-mt-24 px-6 py-16">
            <div class="mx-auto max-w-6xl">
                <div class="mb-10 text-center">
                    <span class="mx-auto block h-1 w-20 rounded-full bg-[#F2A900]"></span>

                    <h2 class="mx-auto mt-6 max-w-5xl text-3xl font-bold tracking-tight text-[#111827] md:text-4xl">
                        {Manual.manExt}
                    </h2>
                </div>

                <div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm md:p-6">
                    <div class="overflow-hidden rounded-lg border border-gray-300 bg-[#1F2937]">
                        <iframe
                            src={`${Manual.pdfExt}#toolbar=1&zoom=page-width`}
                            title={Manual.manExt}
                            class="h-[70vh] w-full"
                        >
                        </iframe>
                    </div>
                </div>

                <div class="mt-6 flex flex-col items-center justify-between gap-4 md:flex-row">
                    <p class="text-sm text-[#4B5563]">
                        Si el visor no carga correctamente, abre el archivo en una nueva pestaña.
                    </p>

                    <a
                        href={Manual.pdfExt}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="rounded-lg bg-[#F2A900] px-6 py-3 text-sm font-semibold text-[#111827] shadow-sm transition hover:bg-[#D49400]"
                    >
                        Abrir PDF
                    </a>
                </div>
            </div>
        </main>

        <!-- FOOTER -->
        <footer id="contacto" class="bg-[#4B5563] px-6 py-12 text-white">
            <div class="mx-auto max-w-6xl text-center">
                <h2 class="text-2xl font-bold uppercase tracking-[0.15em]">
                    Contacto
                </h2>
            <div class="mt-6 space-y-1 text-sm text-gray-200">
                <p>Ing. Ana Claudia Reyes Cruz</p>
                <p>Ing. Roberto Agustín García Castrejón</p>
            </div>

                <p class="mt-6 text-lg font-bold text-white">
                    cae@aragon.unam.mx
                </p>
            </div>
        </footer>
    </body>
</html>