---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Buzón de Quejas y Sugerencias | CAE FES Aragón">
    <Navbar />
    
    <section class="relative overflow-hidden bg-[#111827] pt-16">
        <div class="absolute inset-0 bg-gradient-to-br from-[#111827] via-[#1F2937] to-black"></div>

        <div class="absolute inset-0 opacity-20">
            <div class="h-full w-full bg-[radial-gradient(circle_at_top_right,_#F2A900,_transparent_35%)]"></div>
        </div>

        <div class="relative z-10 mx-auto flex min-h-[330px] max-w-7xl flex-col items-center justify-center px-6 text-center">
            <p class="mb-4 text-sm font-semibold uppercase tracking-[0.35em] text-[#F2A900]">
                CAE FES Aragón
            </p>

            <h1 class="font-sans-flex font-bold text-4xl md:text-5xl text-[#D49400] drop-shadow-lg uppercase">
                Buzón de Quejas y Sugerencias
            </h1>

            <p class="mx-auto mt-6 max-w-4xl text-xl font-normal leading-relaxed text-white drop-shadow-md md:text-2xl">
                Tu voz es fundamental. Ayúdanos a mejorar compartiendo tus quejas, sugerencias o comentarios.
            </p>
        </div>
    </section>

    <main class="bg-white px-6 py-12 flex flex-col items-center">
        <div class="w-full max-w-4xl bg-white border border-gray-100 rounded-2xl shadow-sm p-4 md:p-6">
            <div class="w-full min-h-[600px] rounded-xl overflow-hidden border border-gray-200 bg-gray-50">
                <iframe src="" class="w-full h-full border-0" title="Formulario de Buzón CAE"></iframe>
            </div>
        </div>
    </main>
    
    <Footer />
</Layout>